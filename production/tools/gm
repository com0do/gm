#!/bin/bash
# production/tools/gm -- one entry point for everything gm does.
#
# Without this wrapper a user has to remember three unrelated command
# shapes:
#
#     make libtmcore                                    # build
#     python3 production/make/scripts/dep_query.py ...  # dep queries
#     container/imageBuild.py build image.yaml          # images
#
# ...plus find PROJ_TOP by hand when they're deep in a source tree.
# `gm` unifies them and locates the repo root itself, so every
# command works from any directory.
#
# Install (a symlink, or PATH: the script finds its own checkout through it):
#     ln -s "$PWD/production/tools/gm" ~/.local/bin/gm
#
# Design: this is a THIN dispatcher.  It never reimplements build
# logic -- every subcommand shells out to make / dep_query.py /
# imageBuild.py, and unknown subcommands fall through to make.  That
# keeps `make <anything>` working as the escape hatch and stops this
# script from becoming a second source of truth.

set -uo pipefail

# ------------------------------------------------------------------
# Locate the gm tree -- the directory make runs in.  Two layouts
# (docs/1-USER_GUIDE.md 7.5):
#
#   SINGLE_REPO=Y (default)  gm is vendored in the project: walk up from
#       CWD to the marker pair (a Makefile plus production/make/env.mk).
#       Both are required: a bare Makefile could belong to any project,
#       and production/ alone could be a vendored copy inside a tree
#       whose root is further up.
#   SINGLE_REPO=N (exported)  gm is a checkout next to the project
#       repo(s): the tree is the checkout this script lives in, whatever
#       CWD is; PROJ_TOP is its parent directory.
#
# A vendored tree found above CWD always wins: the project keeps the
# framework it pins, and builds as SINGLE_REPO=Y even when N is exported.
# ------------------------------------------------------------------
find_marker() {
    local d="${GM_PROJ_TOP:-$PWD}"
    while [ "$d" != "/" ]; do
        if [ -f "$d/Makefile" ] && [ -f "$d/production/make/env.mk" ]; then
            printf '%s' "$d"
            return 0
        fi
        d=$(dirname "$d")
    done
    return 1
}

self_tree() {
    local d
    d=$(readlink -f "${BASH_SOURCE[0]}") && d=$(dirname "$(dirname "$(dirname "$d")")") || return 1
    [ -f "$d/Makefile" ] && [ -f "$d/production/make/env.mk" ] && printf '%s' "$d"
}

MARKER=$(find_marker) || MARKER=
SELF=$(self_tree) || SELF=
if [ "${SINGLE_REPO:-Y}" = N ] && [ -n "$SELF" ] && { [ -z "$MARKER" ] || [ "$MARKER" = "$SELF" ]; }; then
    PROJ_TOP=$SELF LAYOUT=N
elif [ -n "$MARKER" ]; then
    PROJ_TOP=$MARKER LAYOUT=Y
else
    echo "gm: not inside a gm tree (no Makefile + production/make/env.mk above $PWD)" >&2
    if [ -n "$SELF" ]; then
        echo "    to build the projects next to $SELF: export SINGLE_REPO=N" >&2
    fi
    echo "    set GM_PROJ_TOP=/path/to/tree to override" >&2
    exit 2
fi

DEP_QUERY="$PROJ_TOP/production/make/scripts/dep_query.py"
IMAGE_BUILD="$PROJ_TOP/container/imageBuild.py"
PRECHECK="$PROJ_TOP/production/tools/precheck.sh"
GMDBG="$PROJ_TOP/production/tools/gmdbg.py"

# ANSI only on a tty.
if [ -t 1 ]; then C_B=$'\e[1m'; C_D=$'\e[2m'; C_R=$'\e[0m'
else C_B=; C_D=; C_R=; fi

# `--no-print-directory` here, not just in env.mk: the outer make
# emits its "Entering/Leaving directory" banner for `-C` before it
# ever parses env.mk, so MAKEFLAGS from there is too late.
run_make() { make --no-print-directory -C "$PROJ_TOP" SINGLE_REPO="$LAYOUT" "$@" ; }

usage() {
cat <<EOF
${C_B}gm${C_R} -- unified entry point for the gm build system
     tree: ${C_D}$PROJ_TOP${C_R}  (SINGLE_REPO=$LAYOUT)

${C_B}BUILD${C_R}
  gm build [<target>...]      build targets (default: all)
  gm clean [<target>...]      clean targets (default: all)
  gm distclean                wipe the output tree
  gm rebuild <target>...      clean + build those targets
  gm list                     list every discovered target
  gm show [<target|type>...]  what gm derived: all targets, one type (lib exe test go java
                              pkg import-lib import-exe), or the details of these targets
  gm test [<name>...]         build + run tests (default: all)

${C_B}DEPENDENCIES${C_R}
  gm deps                     regenerate depend.mk / pkg_of.mk
  gm graph                    dump the file-level DAG
  gm changes <path>...        which targets do these files affect?
  gm since <git-ref>          same, from git diff <ref>..HEAD
  gm refresh [<git-ref>]      rebuild affected + refresh the dep graph

${C_B}IMAGES${C_R}
  gm image build <manifest>   build a container image
  gm image <subcmd> [args]    any imageBuild.py subcommand

${C_B}QUALITY${C_R}
  gm check                    run every local static check (precheck)
  gm coverage [lcov]          coverage report (gcovr, or lcov)

${C_B}DEBUG${C_R} (field crashes; docs 3.16)
  gm core <core> [--exe E]    offline crash analysis: signal, fault, cause, missing symbols
  gm watch --pid P --sym S    who writes this address? (hardware watchpoint, ~native speed)
           [--kernel]         ...also catch read()/recv() writing into it
  gm symbols add|list|find    root-free debuginfo store (debuginfo rpm / dir / ELF)

${C_B}ESCAPE HATCH${C_R}
  gm <anything else>          forwarded verbatim to \`make -C $PROJ_TOP\`
                              e.g. \`gm tmd BUILD_MODE=release\`

${C_B}COMMON FLAGS${C_R} (pass through to make)
  -jN                         parallel
  BUILD_MODE=debug|release
  COVERAGE=1                  gcov instrumentation (any BUILD_MODE)
  SANITIZE=address[,undefined]|thread   sanitizer build (any BUILD_MODE)
  CC=<path> CXX=<path>        compilers (default: gcc/g++ on PATH)
  GM_OUT=<dir>                relocate the output tree
  DEP_TREE=yes                emit .dep.json sidecars while building
EOF
}

need_arg() {
    [ -n "${2:-}" ] || { echo "gm $1: needs an argument (gm help)" >&2; exit 2; }
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
    help|-h|--help)   usage ;;

    # ---- build ----------------------------------------------------
    build)            run_make "${@:-all}" ;;
    clean)
        if [ $# -eq 0 ]; then run_make clean
        else
            # Per-target clean goes through SUB_TARGET, not the `clean`
            # phony (which cleans everything).
            for t in "$@"; do run_make "$t" SUB_TARGET=clean || exit $?; done
        fi ;;
    distclean)        run_make distclean ;;
    rebuild)
        need_arg rebuild "${1:-}"
        for t in "$@"; do run_make "$t" SUB_TARGET=clean || exit $?; done
        run_make "$@" ;;
    list)             run_make -s list ;;
    show)
        if [ $# -eq 0 ]; then run_make -s show
        else run_make -s "${@/#/show-}" ; fi ;;
    test)
        if [ $# -eq 0 ]; then run_make test
        else run_make test TESTS="$*" ; fi ;;

    # ---- dependencies ---------------------------------------------
    deps)             run_make deps "$@" ;;
    graph)            run_make deps-files ;;
    changes)
        need_arg changes "${1:-}"
        # Paths are relative to where the user is, not to the tree.
        abs=()
        for p in "$@"; do abs+=("$(realpath -m -- "$p")"); done
        run_make changes CHANGES="${abs[*]}" ;;
    since)
        need_arg since "${1:-}"
        run_make changes-since SINCE="$1" ;;
    refresh)
        if [ $# -eq 0 ]; then run_make refresh
        else run_make refresh SINCE="$1" ; fi ;;

    # ---- images ---------------------------------------------------
    image|img)
        [ -x "$IMAGE_BUILD" ] || {
            echo "gm image: $IMAGE_BUILD not found or not executable" >&2
            exit 2 ; }
        need_arg image "${1:-}"
        # imageBuild.py resolves manifest paths relative to CWD, so
        # run it from where the user actually is.
        exec python3 "$IMAGE_BUILD" "$@" ;;

    # ---- quality --------------------------------------------------
    check|precheck)   exec bash "$PRECHECK" "$@" ;;
    coverage)
        case "${1:-gcovr}" in
            lcov)  run_make coverage-lcov ;;
            gcovr) run_make coverage ;;
            *)     echo "gm coverage: expected 'gcovr' or 'lcov'" >&2; exit 2 ;;
        esac ;;

    # ---- debugging (gmdbg.py) -------------------------------------
    watch|core|symbols) exec python3 "$GMDBG" "$cmd" "$@" ;;

    # ---- raw dep_query (power users) ------------------------------
    dep-query|dq)     exec python3 "$DEP_QUERY" "$@" ;;

    # ---- escape hatch ---------------------------------------------
    # Anything unrecognised is a make goal.  Keeps `gm libtmcore`,
    # `gm pkg-tmd BUILD_MODE=release`, `gm -j8 all` working without
    # this script needing to know every target name.
    *)                run_make "$cmd" "$@" ;;
esac
